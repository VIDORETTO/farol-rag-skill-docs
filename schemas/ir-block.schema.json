{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/ir-block.schema.json",
  "title": "Farol 2.0 canonical IR block",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "block_id", "parent_id", "ordinal", "text", "structured", "heading_path", "symbol", "locators", "language", "confidence", "quality_flags", "source_fragment_hash"],
  "properties": {
    "schema_version": {"const": 2, "type": "integer"},
    "kind": {"type": "string", "enum": ["title", "heading", "paragraph", "list", "table", "table_row", "code", "quote", "figure", "caption", "equation", "metadata"]},
    "block_id": {"type": "string", "minLength": 1},
    "parent_id": {"type": ["string", "null"]},
    "ordinal": {"type": "integer", "minimum": 0},
    "text": {"type": ["string", "null"]},
    "structured": {"type": ["object", "null"]},
    "heading_path": {"type": "array", "items": {"type": "string"}},
    "symbol": {"type": ["string", "null"]},
    "locators": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "language": {"type": ["string", "null"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "quality_flags": {"type": "array", "items": {"type": "string"}},
    "source_fragment_hash": {"type": ["string", "null"]}
  }
}
