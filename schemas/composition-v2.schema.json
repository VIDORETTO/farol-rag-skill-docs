{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/composition-v2.schema.json",
  "title": "Farol 2.0 composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "composition_id", "components", "impact", "status", "evaluation", "previous_composition_id", "invalidates"],
  "properties": {
    "schema_version": {"const": 2, "type": "integer"},
    "kind": {"const": "composition", "type": "string"},
    "composition_id": {"type": "string", "minLength": 1},
    "components": {"type": "object"},
    "impact": {"type": "string"},
    "status": {"type": "string"},
    "evaluation": {"type": "object"},
    "previous_composition_id": {"type": ["string", "null"]},
    "invalidates": {"type": "array", "items": {"type": "string"}}
  }
}
