{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/operation-result-v2.schema.json",
  "title": "Farol 2.0 resumable operation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "kind", "operation_id", "project_id", "idempotency_key", "status", "revision", "pending", "next_action", "blockers", "result", "extensions"],
  "properties": {
    "schema_version": {"const": 2, "type": "integer"},
    "contract_version": {"const": "2.0", "type": "string"},
    "kind": {"const": "operation_result", "type": "string"},
    "operation_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "needs_input", "blocked", "failed", "resumed"], "type": "string"},
    "revision": {"type": "integer", "minimum": 0},
    "pending": {"type": "array", "items": {"type": "object"}},
    "next_action": {"type": "string", "minLength": 1},
    "blockers": {"type": "array", "items": {"type": "object"}},
    "result": {"type": "object"},
    "extensions": {"type": "object"}
  }
}
