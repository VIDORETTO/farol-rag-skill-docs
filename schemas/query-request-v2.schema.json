{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/query-request-v2.schema.json",
  "title": "Farol 2.0 query request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "query", "top_k", "project_revision", "filters", "as_of", "region"],
  "properties": {
    "schema_version": {"const": 2, "type": "integer"},
    "kind": {"const": "query_request", "type": "string"},
    "query": {"type": "string", "minLength": 1},
    "top_k": {"type": "integer", "minimum": 1},
    "project_revision": {"type": ["string", "null"]},
    "filters": {"type": "object"},
    "as_of": {"type": ["string", "null"]},
    "region": {"type": ["string", "null"]}
  }
}
