{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/backend-candidate.schema.json",
  "title": "Farol 2.0 backend candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "candidate_id", "project_revision", "ir_revision", "backend", "state", "metadata"],
  "properties": {
    "schema_version": {"const": 2, "type": "integer"},
    "kind": {"const": "backend_candidate", "type": "string"},
    "candidate_id": {"type": "string", "minLength": 1},
    "project_revision": {"type": "string", "minLength": 1},
    "ir_revision": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "minLength": 1},
    "state": {"type": "string"},
    "metadata": {"type": "object"}
  }
}
