{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/ir-document.schema.json",
  "title": "Farol 2.0 canonical IR document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "document_id", "source_id", "source_revision_id", "artifact_id", "content_hash", "media_type", "language", "extractor", "fidelity", "rights_ref", "captured_at", "effective_at", "region", "blocks", "assets", "origin"],
  "properties": {
    "schema_version": {"const": 2, "type": "integer"},
    "kind": {"const": "ir_document", "type": "string"},
    "document_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_revision_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "media_type": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "extractor": {"type": "object"},
    "fidelity": {"type": "object"},
    "rights_ref": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "minLength": 20},
    "effective_at": {"type": ["string", "null"]},
    "region": {"type": ["string", "null"]},
    "blocks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "assets": {"type": "array", "items": {"type": "object"}},
    "origin": {"type": ["string", "null"]},
    "revision_id": {"type": "string"}
  }
}
