{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/operation-v2.schema.json",
  "title": "Farol 2.0 resumable operation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "kind", "operation_id", "project_id", "session_id", "operation", "idempotency_key", "expected_revision", "inputs", "requested_at", "extensions"],
  "properties": {
    "schema_version": {"const": 2, "type": "integer"},
    "contract_version": {"const": "2.0", "type": "string"},
    "kind": {"const": "operation", "type": "string"},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"enum": ["start", "inspect", "plan", "apply", "resume", "migrate"], "type": "string"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "expected_revision": {"type": "integer", "minimum": 0},
    "inputs": {"type": "object"},
    "requested_at": {"type": "string", "minLength": 20},
    "extensions": {"type": "object"}
  }
}
