{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOCOPS project brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "created_at", "content_hash", "revision_id", "project_id", "goal", "audience", "region", "language", "deliverables", "constraints", "open_decision_ids"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "kind": {"const": "brief", "type": "string"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 20},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "audience": {"type": ["string", "null"]},
    "region": {"type": ["string", "null"]},
    "language": {"type": ["string", "null"]},
    "deliverables": {"type": "array", "items": {"enum": ["knowledge"], "type": "string"}, "uniqueItems": true},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "open_decision_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "extensions": {"type": "object"}
  }
}
