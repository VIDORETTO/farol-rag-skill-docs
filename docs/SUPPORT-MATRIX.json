{
  "schema_version": 1,
  "python": {
    "supported": [
      "3.11",
      "3.12",
      "3.13"
    ],
    "tolerated": [
      "3.14"
    ],
    "minimum": "3.11"
  },
  "runners": [
    "ubuntu-latest",
    "windows-latest",
    "macos-latest"
  ],
  "gates": {
    "quick": [
      "pytest",
      "ruff",
      "format",
      "doctor",
      "dependency-audit",
      "pip-check",
      "workflow-yaml",
      "contract-conformance",
      "public-seams",
      "release-audit"
    ],
    "clean_clone": [
      "doctor",
      "release-audit",
      "pytest"
    ],
    "package": [
      "wheel-create-validate-evaluate",
      "supply-chain",
      "supply-chain-verify",
      "candidate-audit",
      "candidate-bundle",
      "candidate-verify"
    ],
    "integration": [
      "ragflow-profile"
    ]
  },
  "profiles": {
    "core": {
      "gates": [
        "quick"
      ],
      "optional": false
    },
    "formats": {
      "gates": [
        "quick"
      ],
      "optional": true
    },
    "bootstrap": {
      "gates": [
        "clean_clone"
      ],
      "optional": false
    },
    "wheel": {
      "gates": [
        "package"
      ],
      "optional": false
    },
    "filesystem": {
      "gates": [
        "integration"
      ],
      "optional": false
    },
    "ragflow": {
      "gates": [
        "integration"
      ],
      "optional": true
    }
  },
  "claims": [
    {
      "id": "core-cross-platform",
      "platforms": [
        "ubuntu-latest",
        "windows-latest",
        "macos-latest"
      ],
      "python_versions": [
        "3.11",
        "3.12",
        "3.13"
      ],
      "profile": "core",
      "job": "quick"
    },
    {
      "id": "clean-clone-cross-platform",
      "platforms": [
        "ubuntu-latest",
        "windows-latest",
        "macos-latest"
      ],
      "profile": "bootstrap",
      "job": "clean-clone"
    },
    {
      "id": "wheel-linux",
      "platforms": [
        "ubuntu-latest"
      ],
      "profile": "wheel",
      "job": "package"
    },
    {
      "id": "rag-linux",
      "platforms": [
        "ubuntu-latest"
      ],
      "profile": "ragflow",
      "job": "ragflow"
    },
    {
      "id": "filesystem-linux",
      "platforms": [
        "ubuntu-latest"
      ],
      "profile": "filesystem",
      "job": "ragflow"
    }
  ],
  "wrappers": {
    "bootstrap": [
      "scripts/bootstrap.py",
      "scripts/bootstrap.ps1",
      "scripts/bootstrap.sh"
    ],
    "operations": [
      "scripts/update_docs.ps1",
      "scripts/run_release_gates.py"
    ]
  },
  "skips": [
    {
      "id": "rag-optional",
      "condition": "RAGFlow external inputs unavailable",
      "observable": "status=blocked with missing external inputs"
    },
    {
      "id": "symlink-capability",
      "condition": "filesystem cannot create symlinks",
      "observable": "pytest skip"
    }
  ],
  "order": [
    "bootstrap",
    "doctor",
    "dependencies",
    "support-matrix",
    "contracts",
    "public-seams",
    "pytest",
    "ruff",
    "clean-clone",
    "wheel",
    "supply-chain",
    "supply-chain-verify",
    "ragflow",
    "candidate-audit",
    "candidate-bundle",
    "candidate-verify"
  ]
}
